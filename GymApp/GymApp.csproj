<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <ApplicationIcon>Assets\gymapp_icon.ico</ApplicationIcon>
    </PropertyGroup>

    <ItemGroup>
        <Content Include="Assets\gymapp_icon.ico" />
    </ItemGroup>

    <ItemGroup>
        <AvaloniaResource Include="Assets\**" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.0.4" />
        <PackageReference Include="Avalonia.Desktop" Version="12.0.4" />
        <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.4" />
        <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.4" />
        <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.1">
            <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
            <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
        </PackageReference>
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.1" />
        <PackageReference Include="FluentValidation" Version="12.1.1" />
        <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.9" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.9">
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
          <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.9" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.9">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="QuestPDF" Version="2026.6.1" />
    </ItemGroup>

    <ItemGroup>
      <Compile Update="Views\ExerciseView.axaml.cs">
        <DependentUpon>ExerciseView.axaml</DependentUpon>
      </Compile>
      <Compile Update="Views\GoalView.axaml.cs">
        <DependentUpon>GoalView.axaml</DependentUpon>
      </Compile>
      <Compile Update="Views\SupplementView.cs">
        <DependentUpon>SupplementView.axaml</DependentUpon>
      </Compile>
      <Compile Update="Views\SupplementView.axaml.cs">
        <DependentUpon>SupplementView.axaml</DependentUpon>
      </Compile>
      <Compile Update="Views\NutritionView.axaml.cs">
        <DependentUpon>Nutrition.axaml</DependentUpon>
      </Compile>
      <Compile Update="Views\PersonalRecordView.axaml.cs">
        <DependentUpon>PersonalRecordView.axaml</DependentUpon>
      </Compile>
      <Compile Update="Views\SupplementIntakeView.axaml.cs">
        <DependentUpon>SupplementIntakeView.axaml</DependentUpon>
      </Compile>
      <Compile Update="Views\WorkoutProgramView.axaml.cs">
        <DependentUpon>WorkoutProgramView.axaml</DependentUpon>
      </Compile>
      <Compile Update="Views\UserView.axaml.cs">
        <DependentUpon>UserView.axaml</DependentUpon>
      </Compile>
      <Compile Update="Views\AddExerciseWindow.cs">
        <DependentUpon>AddExerciseWindow.axaml</DependentUpon>
      </Compile>
      <Compile Update="Views\AddExerciseWindow.axaml.cs">
        <DependentUpon>AddExerciseWindow.axaml</DependentUpon>
      </Compile>
      <Compile Update="Views\AddSupplementWindow.axaml.cs">
        <DependentUpon>AddSupplementWindow.axaml</DependentUpon>
      </Compile>
      <Compile Update="Views\ConfirmDialog.axaml.cs">
        <DependentUpon>ConfirmDialog.axaml</DependentUpon>
      </Compile>
      <Compile Update="Views\AddGoalWindow.axaml.cs">
        <DependentUpon>AddGoalWindow.axaml</DependentUpon>
      </Compile>
      <Compile Update="Views\AddRecordWindow.axaml.cs">
        <DependentUpon>AddRecordWindow.axaml</DependentUpon>
      </Compile>
      <Compile Update="Views\AddIntakeWindow.axaml.cs">
        <DependentUpon>AddIntakeWindow.axaml</DependentUpon>
      </Compile>
      <Compile Update="Views\AddExerciseToProgramWindow.axaml.cs">
        <DependentUpon>AddExerciseToProgramWindow.axaml</DependentUpon>
      </Compile>
      <Compile Update="Views\LoginWindow.axaml.cs">
        <DependentUpon>LoginWindow.axaml</DependentUpon>
      </Compile>
    </ItemGroup>

    <ItemGroup>
      <Folder Include="Styles\" />
    </ItemGroup>
</Project>
