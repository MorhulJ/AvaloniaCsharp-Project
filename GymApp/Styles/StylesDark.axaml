<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Styles.Resources>
        <Color x:Key="BgColor">#211A14</Color>
        <Color x:Key="CardColor">#2E251D</Color>
        <Color x:Key="Terracotta">#E0703F</Color>
        <Color x:Key="TerracottaLight">#F0935E</Color>
        <Color x:Key="BorderColor">#473A2D</Color>
        <Color x:Key="TextPrimary">#F2E9DD</Color>
        <Color x:Key="TextMuted">#A99A85</Color>

        <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}" />
        <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}" />
        <SolidColorBrush x:Key="TerracottaBrush" Color="{StaticResource Terracotta}" />
        <SolidColorBrush x:Key="TerracottaLightBrush" Color="{StaticResource TerracottaLight}" />
        <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
        <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextPrimary}" />
        <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource TextMuted}" />
    </Styles.Resources>

    <Style Selector="Window">
        <Setter Property="Background" Value="{StaticResource BgBrush}" />
    </Style>

    <Style Selector="UserControl">
        <Setter Property="Background" Value="{StaticResource BgBrush}" />
    </Style>

    <Style Selector="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FontFamily" Value="Georgia, Times New Roman, serif" />
    </Style>

    <Style Selector="TextBlock.label">
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontFamily" Value="Segoe UI, Arial, sans-serif" />
    </Style>

    <Style Selector="TextBlock.title">
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontStyle" Value="Italic" />
        <Setter Property="Foreground" Value="{StaticResource TerracottaBrush}" />
    </Style>

    <Style Selector="TextBox">
        <Setter Property="Background" Value="{StaticResource CardBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="FontFamily" Value="Segoe UI, Arial, sans-serif" />
    </Style>

    <Style Selector="ComboBox">
        <Setter Property="Background" Value="{StaticResource CardBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="FontFamily" Value="Segoe UI, Arial, sans-serif" />
    </Style>

    <Style Selector="Button">
        <Setter Property="Background" Value="{StaticResource TerracottaBrush}" />
        <Setter Property="Foreground" Value="#211A14" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16,9" />
        <Setter Property="FontFamily" Value="Segoe UI, Arial, sans-serif" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style Selector="Button:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource TerracottaLightBrush}" />
    </Style>

    <Style Selector="Button.danger">
        <Setter Property="Background" Value="#8C4A33" />
        <Setter Property="Foreground" Value="#F2E9DD" />
    </Style>

    <Style Selector="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="ListBoxItem">
        <Setter Property="Background" Value="{StaticResource CardBrush}" />
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
        <Setter Property="Background" Value="#3A2E23" />
        <Setter Property="BorderBrush" Value="{StaticResource TerracottaBrush}" />
        <Setter Property="BorderThickness" Value="1.5" />
    </Style>
    
    <Style Selector="DatePicker /template/ TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI, Arial, sans-serif" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style Selector="DatePickerPresenter TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI, Arial, sans-serif" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style Selector="DateTimePickerPanel TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI, Arial, sans-serif" />
        <Setter Property="FontSize" Value="14" />
    </Style>
    
    <Style Selector="DateTimePickerPanel ListBoxItem">
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    
    <Style Selector="StackPanel.result-card">
        <Setter Property="Background" Value="{StaticResource CardBrush}" />
        <Setter Property="Margin" Value="0,0,0,0" />
    </Style>
    
    <Style Selector="StackPanel.result-card">
        <Setter Property="Background" Value="{StaticResource CardBrush}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

</Styles>