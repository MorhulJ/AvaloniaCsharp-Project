<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GymApp.ViewModels"
        x:Class="GymApp.Views.AddSupplementWindow"
        x:DataType="vm:SupplementViewModel"
        Title="Add Supplement"
        Width="400" Height="300"
        WindowStartupLocation="CenterOwner">

    <StackPanel Margin="20" Spacing="10">

        <TextBlock Text="Supplement name" />
        <TextBox Text="{Binding SupplementName}" />

        <TextBlock Text="Dosage Unit" />
        <TextBox Text="{Binding DosageUnit}" />

        <TextBlock Text="Description" />
        <TextBox Text="{Binding Description}" />

        <Button Content="Save" Command="{Binding SaveSupplementCommand}" />

    </StackPanel>

</Window>