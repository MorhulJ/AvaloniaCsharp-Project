<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GymApp.ViewModels"
             x:Class="GymApp.Views.ExerciseView"
             x:DataType="vm:ExerciseViewModel">

    <StackPanel Margin="30" Spacing="16">

        <TextBlock Text="My Exercises" Classes="title" />

        <Button Content="+ Add exercise" Click="OpenAddExerciseWindow" HorizontalAlignment="Left" />

        <ListBox ItemsSource="{Binding Exercises}" SelectedItem="{Binding SelectedExercise}" Height="420">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Spacing="4">
                        <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding MuscleGroup}" Classes="label" />
                            <TextBlock Text="·" Classes="label" />
                            <TextBlock Text="{Binding Description}" Classes="label" />
                        </StackPanel>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Edit" Click="OpenEditExerciseWindow" />
            <Button Content="Delete" Classes="danger" Click="OnDeleteExercise" />
        </StackPanel>

    </StackPanel>

</UserControl>