<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GymApp.ViewModels"
             x:Class="GymApp.Views.ExerciseView"
             x:DataType="vm:ExerciseViewModel">

    <StackPanel Margin="20" Spacing="10">

        <Button Content="Add Exercise" Click="OpenAddExerciseWindow" />

        <TextBlock Text="Exercise list:" Margin="0,10,0,0" />
        <ListBox ItemsSource="{Binding Exercises}" SelectedItem="{Binding SelectedExercise}" Height="400">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,4">
                        <TextBlock Text="{Binding Name}" FontWeight="Bold" />
                        <TextBlock>
                            <Run Text="{Binding MuscleGroup}" />
                            <Run Text=" — " />
                            <Run Text="{Binding Description}" />
                        </TextBlock>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Content="Edit" Click="OpenEditExerciseWindow" />
            <Button Content="Delete" Click="OnDeleteExercise" />
        </StackPanel>

    </StackPanel>

</UserControl>