<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GymApp.ViewModels"
             x:Class="GymApp.Views.ExerciseView"
             x:DataType="vm:ExerciseViewModel">

    <Grid Margin="30" RowDefinitions="Auto,Auto,Auto,*,Auto">

        <TextBlock Grid.Row="0" Text="My Exercises" Classes="title" Margin="0,0,0,16" />

        <Button Grid.Row="1" Content="+ Add exercise" Click="OpenAddExerciseWindow" HorizontalAlignment="Left" Margin="0,0,0,12" />

        <TextBlock Grid.Row="2" Text="Exercise list" Classes="label" Margin="0,0,0,8" />

        <Grid Grid.Row="3">
        <ListBox ItemsSource="{Binding Exercises}" SelectedItem="{Binding SelectedExercise}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Spacing="4">
                        <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding MuscleGroup}" Classes="label" />
                            <TextBlock Text="·" Classes="label" />
                            <TextBlock Text="{Binding Description}" Classes="label" />
                        </StackPanel>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <Border IsVisible="{Binding IsExerciseListEmpty}" IsHitTestVisible="False"
                Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="12" Margin="4" Padding="24">
            <StackPanel Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="No exercises yet" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Text="Add an exercise to start building your library." Classes="label" TextWrapping="Wrap" TextAlignment="Center" />
            </StackPanel>
        </Border>
        </Grid>

        <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
            <Button Content="Edit" Click="OpenEditExerciseWindow" HorizontalContentAlignment="Center" Width="80" IsEnabled="{Binding HasSelection}" />
            <Button Content="Delete" Classes="danger" Click="OnDeleteExercise" HorizontalContentAlignment="Center" Width="80" IsEnabled="{Binding HasSelection}" />
        </StackPanel>

    </Grid>

</UserControl>
