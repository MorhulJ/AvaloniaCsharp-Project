<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GymApp.ViewModels"
        x:Class="GymApp.Views.AddIntakeWindow"
        x:DataType="vm:SupplementIntakeViewModel"
        Title="Add Intake"
        Icon="avares://GymApp/Assets/gymapp_icon.png"
        Width="420" Height="430"
        WindowStartupLocation="CenterOwner">

    <StackPanel Classes="dialog-content">

        <TextBlock Text="Supplement intake" Classes="title dialog-title" />

        <StackPanel Spacing="6">
            <TextBlock Text="Supplement" Classes="label" />
            <ComboBox ItemsSource="{Binding Supplements}"
                      SelectedItem="{Binding Supplement}"
                      HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </StackPanel>

        <StackPanel Spacing="6">
            <TextBlock Text="Dosage" Classes="label" />
            <TextBox Text="{Binding SupplementDosage}" PlaceholderText="e.g., 5" />
        </StackPanel>

        <StackPanel Spacing="6">
            <TextBlock Text="Day" Classes="label" />
            <ComboBox ItemsSource="{Binding DayOptions}"
                      SelectedItem="{Binding SupplementDay}"
                      HorizontalAlignment="Stretch" />
        </StackPanel>

        <StackPanel Spacing="6">
            <TextBlock Text="Time (hh:mm)" Classes="label" />
            <TextBox Text="{Binding SupplementTime}" PlaceholderText="e.g., 08:30" />
        </StackPanel>

        <Button Content="Save" Command="{Binding SaveSupplementIntakeCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,10,0,0" />

        <TextBlock Text="{Binding ValidationMessage}" 
                   Foreground="Red"
                   IsVisible="{Binding ValidationMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        
    </StackPanel>

</Window>
