<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GymApp.ViewModels"
        x:Class="GymApp.Views.AddExerciseWindow"
        x:DataType="vm:ExerciseViewModel"
        Title="Add Exercise"
        Width="400" Height="300"
        WindowStartupLocation="CenterOwner">

    <StackPanel Margin="20" Spacing="10">

        <TextBlock Text="Exercise name" />
        <TextBox Text="{Binding ExerciseName}" />

        <TextBlock Text="Muscle group" />
        <TextBox Text="{Binding MuscleGroup}" />

        <TextBlock Text="Description" />
        <TextBox Text="{Binding Description}" />

        <Button Content="Save" Command="{Binding SaveExerciseCommand}" />

    </StackPanel>

</Window>