<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GymApp.ViewModels"
             x:Class="GymApp.Views.WorkoutProgramView"
             x:DataType="vm:WorkoutProgramViewModel">

    <StackPanel Margin="20" Spacing="10">
        
        <Button Content="Add Program" Click="OpenAddProgramWindow" />

        <TextBlock Text="Select program"
                   Margin="0,10,0,0" />
        <ComboBox ItemsSource="{Binding WorkoutPrograms}" SelectedItem="{Binding SelectedProgram}">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Name}" />
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
        
        <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Content="Edit Program" Click="OpenEditProgramWindow" />
            <Button Content="Delete Program" Click="OnDeleteWorkoutProgram" />
        </StackPanel>
        
        <TextBlock Text="Program exercises:"
                   Margin="0,10,0,0" />

        <ListBox ItemsSource="{Binding ProgramExercises}"
                 SelectedItem="{Binding SelectedProgramExercise}"
                 Height="400">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,4">
                        <TextBlock Text="{Binding Exercise.Name}" FontWeight="Bold" />
                        <TextBlock>
                            <Run Text="Sets: " />
                            <Run Text="{Binding Sets}" />
                            <Run Text="  Reps: " />
                            <Run Text="{Binding Reps}" />
                            <Run Text="  Rest: " />
                            <Run Text="{Binding RestTime}" />
                        </TextBlock>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        
        <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Content="Add Exercise" Click="OpenAddExerciseToProgramWindow" />
            <Button Content="Delete Exercise" Click="OnDeleteExerciseFromProgram" />
        </StackPanel>
        
    </StackPanel>
    
</UserControl>