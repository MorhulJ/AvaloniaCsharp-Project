<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GymApp.ViewModels"
             x:Class="GymApp.Views.WorkoutProgramView"
             x:DataType="vm:WorkoutProgramViewModel">

    <Grid Margin="30" RowDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto">

        <TextBlock Grid.Row="0" Text="Workout programs" Classes="title" Margin="0,0,0,16" />

        <Button Grid.Row="1" Content="+ Add program" Click="OpenAddProgramWindow" HorizontalAlignment="Left" Margin="0,0,0,12" />

        <StackPanel Grid.Row="2" Spacing="6" Margin="0,0,0,12">
            <TextBlock Text="Select program" Classes="label" />
            <ComboBox ItemsSource="{Binding WorkoutPrograms}"
                      SelectedItem="{Binding SelectedProgram}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
            <Button Content="Edit" Click="OpenEditProgramWindow" HorizontalContentAlignment="Center" Width="80" IsEnabled="{Binding HasSelectedProgram}" />
            <Button Content="Delete" Classes="danger" Click="OnDeleteWorkoutProgram" HorizontalContentAlignment="Center" Width="80" IsEnabled="{Binding HasSelectedProgram}" />
        </StackPanel>

        <TextBlock Grid.Row="4" Text="Exercises in program" Classes="label" Margin="0,0,0,8" />

        <Grid Grid.Row="5">
        <ListBox ItemsSource="{Binding ProgramExercises}"
                 SelectedItem="{Binding SelectedProgramExercise}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Spacing="4">
                        <TextBlock Text="{Binding Exercise.Name}" FontSize="15" FontWeight="Bold" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Classes="label">
                                <Run Text="Sets: " />
                                <Run Text="{Binding Sets}" />
                            </TextBlock>
                            <TextBlock Classes="label">
                                <Run Text="Reps: " />
                                <Run Text="{Binding Reps}" />
                            </TextBlock>
                            <TextBlock Classes="label">
                                <Run Text="Rest: " />
                                <Run Text="{Binding RestTime}" />
                                <Run Text="s" />
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <Border IsVisible="{Binding IsProgramExerciseListEmpty}" IsHitTestVisible="False"
                Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="12" Margin="4" Padding="24">
            <StackPanel Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="No exercises in this program" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Text="Add an exercise to build this workout." Classes="label" TextWrapping="Wrap" TextAlignment="Center" />
            </StackPanel>
        </Border>
        </Grid>

        <StackPanel Grid.Row="6" Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
            <Button Content="+ Add exercise" Click="OpenAddExerciseToProgramWindow" IsEnabled="{Binding HasSelectedProgram}" />
            <Button Content="Delete exercise" Classes="danger" Click="OnDeleteExerciseFromProgram" IsEnabled="{Binding HasSelectedProgramExercise}" />
        </StackPanel>

    </Grid>

</UserControl>
