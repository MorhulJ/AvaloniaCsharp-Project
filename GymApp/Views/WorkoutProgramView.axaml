<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GymApp.ViewModels"
             x:Class="GymApp.Views.WorkoutProgramView"
             x:DataType="vm:WorkoutProgramViewModel">

    <StackPanel Margin="20" Spacing="10">

        <TextBlock Text="Program name" />
        <TextBox Text="{Binding ProgramName}" />

        <TextBlock Text="Description" />
        <TextBox Text="{Binding ProgramDescription}" />

        <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Content="Save" Command="{Binding SaveProgramCommand}" />
            <Button Content="Delete" Click="OnDeleteWorkoutProgram" />
        </StackPanel>

        <TextBlock Text="Select program"
                   Margin="0,10,0,0" />
        <ComboBox ItemsSource="{Binding WorkoutPrograms}" SelectedItem="{Binding SelectedProgram}">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Name}" />
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <TextBlock Text="Exercise"
                   Margin="0,10,0,0" />

        <ComboBox ItemsSource="{Binding Exercises}" SelectedItem="{Binding SelectedExercise}">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Name}" />
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <TextBlock Text="Sets" />
        <TextBox Text="{Binding ExerciseSets}" />
        
        <TextBlock Text="Reps" />
        <TextBox Text="{Binding ExerciseReps}" />
        
        <TextBlock Text="Rest time (seconds)" />
        <TextBox Text="{Binding ExerciseRestTime}" />
        
        <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Content="Add exercise" Command="{Binding AddExerciseToProgramCommand}" />
            <Button Content="Delete exercise" Click="OnDeleteExerciseFromProgram" />
        </StackPanel
        >
        <TextBlock Text="Program exercises:"
                   Margin="0,10,0,0" />

        <ListBox ItemsSource="{Binding ProgramExercises}"
                 SelectedItem="{Binding SelectedProgramExercise}"
                 Height="250">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,4">
                        <TextBlock Text="{Binding Exercise.Name}" FontWeight="Bold" />
                        <TextBlock>
                            <Run Text="Sets: " />
                            <Run Text="{Binding Sets}" />
                            <Run Text="  Reps: " />
                            <Run Text="{Binding Reps}" />
                            <Run Text="  Rest: " />
                            <Run Text="{Binding RestTime}" />
                        </TextBlock>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        
    </StackPanel>
    
</UserControl>