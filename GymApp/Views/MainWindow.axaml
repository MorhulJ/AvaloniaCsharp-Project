<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GymApp.ViewModels"
        x:Class="GymApp.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="GymApp"
        WindowState="Maximized">

    <DockPanel>

        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="10">

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                <Button Content="Workout Program" Command="{Binding ShowWorkoutProgramCommand}" />
                <Button Content="Exercises" Command="{Binding ShowExercisesCommand}" />
                <Button Content="Goals" Command="{Binding ShowGoalsCommand}" />
                <Button Content="Personal Records" Command="{Binding ShowPersonalRecordCommand}" />
                <Button Content="Supplements" Command="{Binding ShowSupplementsCommand}" />
                <Button Content="Supplement Intake" Command="{Binding ShowSupplementIntakeCommand}" />
                <Button Content="Nutrition calculator" Command="{Binding ShowNutritionCommand}" />
                <Button Content="User" Command="{Binding ShowUserCommand}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                <Button Content="Generate Report" Command="{Binding GenerateReportCommand}" />
                <Button Content="Theme" Command="{Binding ToggleThemeCommand}" />
            </StackPanel>

        </Grid>

        <ContentControl Content="{Binding CurrentView}" />

    </DockPanel>

</Window>