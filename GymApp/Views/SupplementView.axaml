<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GymApp.ViewModels"
             x:Class="GymApp.Views.SupplementView"
             x:DataType="vm:SupplementViewModel">

    <StackPanel Margin="20" Spacing="10">

        <Button Content="Add Supplement" Click="OpenAddSupplementWindow" />

        <TextBlock Text="Supplements list:" Margin="0,10,0,0" />
        <ListBox ItemsSource="{Binding Suplements}" SelectedItem="{Binding SelectedSupplement}" Height="400">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,4">
                        <TextBlock Text="{Binding Name}" FontWeight="Bold" />
                        <TextBlock>
                            <Run Text="{Binding DosageUnit}" />
                            <Run Text=" — " />
                            <Run Text="{Binding Description}" />
                        </TextBlock>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Content="Edit" Click="OpenEditSupplementWindow" />
            <Button Content="Delete" Click="OnDeleteSupplement" />
        </StackPanel>

    </StackPanel>

</UserControl>