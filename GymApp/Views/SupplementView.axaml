<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GymApp.ViewModels"
             x:Class="GymApp.Views.SupplementView"
             x:DataType="vm:SupplementViewModel">

    <StackPanel Margin="30" Spacing="16">

        <TextBlock Text="Supplements" Classes="title" />

        <Button Content="+ Add supplement" Click="OpenAddSupplementWindow" HorizontalAlignment="Left" HorizontalContentAlignment="Center" />

        <TextBlock Text="Supplements list" Classes="label" Margin="0,10,0,0" />
        <ListBox ItemsSource="{Binding Suplements}" SelectedItem="{Binding SelectedSupplement}" Height="400">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Spacing="4">
                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="Bold" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Classes="label" Text="{Binding DosageUnit}" />
                            <TextBlock Classes="label" Text="·" />
                            <TextBlock Classes="label" Text="{Binding Description}" />
                        </StackPanel>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Edit" Click="OpenEditSupplementWindow" HorizontalContentAlignment="Center" Width="80"/>
            <Button Content="Delete" Classes="danger" Click="OnDeleteSupplement" HorizontalContentAlignment="Center" Width="80" />
        </StackPanel>

    </StackPanel>

</UserControl>