<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GymApp.ViewModels"
             x:Class="GymApp.Views.SupplementView"
             x:DataType="vm:SupplementViewModel">

    <StackPanel Margin="20" Spacing="10">

        <TextBlock Text="Supplement name" />
        <TextBox Text="{Binding SupplementName}" />

        <TextBlock Text="Dosage unit" />
        <TextBox Text="{Binding DosageUnit}" />

        <TextBlock Text="Description" />
        <TextBox Text="{Binding Description}" />

        <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Content="Save" Command="{Binding SaveSupplementCommand}" />
            <Button Content="Delete" Command="{Binding DeleteSupplementCommand}" />
        </StackPanel>

        <TextBlock Text="Supplement list:" Margin="0,10,0,0" />
        <ListBox ItemsSource="{Binding Suplements}" SelectedItem="{Binding SelectedSupplement}" Height="200">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,4">
                        <TextBlock Text="{Binding Name}" FontWeight="Bold" />
                        <TextBlock>
                            <Run Text="{Binding Description}" />
                            <Run Text=" — " />
                            <Run Text="{Binding DosageUnit}" />
                        </TextBlock>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

    </StackPanel>

</UserControl>