<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GymApp.ViewModels"
             x:Class="GymApp.Views.SupplementView"
             x:DataType="vm:SupplementViewModel">

    <Grid Margin="30" RowDefinitions="Auto,Auto,Auto,*,Auto">

        <TextBlock Grid.Row="0" Text="Supplements" Classes="title" Margin="0,0,0,16" />

        <Button Grid.Row="1" Content="+ Add supplement" Click="OpenAddSupplementWindow" HorizontalAlignment="Left" HorizontalContentAlignment="Center" Margin="0,0,0,12" />

        <TextBlock Grid.Row="2" Text="Supplements list" Classes="label" Margin="0,0,0,8" />
        <Grid Grid.Row="3">
        <ListBox ItemsSource="{Binding Suplements}" SelectedItem="{Binding SelectedSupplement}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Spacing="4">
                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="Bold" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Classes="label" Text="{Binding DosageUnit}" />
                            <TextBlock Classes="label" Text="·" />
                            <TextBlock Classes="label" Text="{Binding Description}" />
                        </StackPanel>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <Border IsVisible="{Binding IsSupplementListEmpty}" IsHitTestVisible="False"
                Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="12" Margin="4" Padding="24">
            <StackPanel Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="No supplements yet" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Text="Add supplements to keep your list organized." Classes="label" TextWrapping="Wrap" TextAlignment="Center" />
            </StackPanel>
        </Border>
        </Grid>

        <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
            <Button Content="Edit" Click="OpenEditSupplementWindow" HorizontalContentAlignment="Center" Width="80" IsEnabled="{Binding HasSelection}" />
            <Button Content="Delete" Classes="danger" Click="OnDeleteSupplement" HorizontalContentAlignment="Center" Width="80" IsEnabled="{Binding HasSelection}" />
        </StackPanel>

    </Grid>

</UserControl>
