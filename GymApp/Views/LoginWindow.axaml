<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GymApp.ViewModels"
        x:Class="GymApp.Views.LoginWindow"
        x:DataType="vm:LoginViewModel"
        Title="GymApp — Login"
        Icon="avares://GymApp/Assets/gymapp_icon.png"
        Width="400" Height="620"
        WindowStartupLocation="CenterScreen"
        CanResize="False"
        Opened="OnOpened">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="30" Spacing="14">

        <TextBlock Text="GymApp" Classes="title" FontSize="28" HorizontalAlignment="Center" />

        <TextBlock Text="{Binding ModeTitle}"
                   Classes="label" HorizontalAlignment="Center" FontSize="14" />

        <StackPanel Spacing="6" IsVisible="{Binding IsRegistering}">
            <TextBlock Text="Name" Classes="label" />
            <TextBox x:Name="NameInput" Text="{Binding Name}" PlaceholderText="Your name" />
        </StackPanel>

        <StackPanel Spacing="6">
            <TextBlock Text="Email" Classes="label" />
            <TextBox x:Name="EmailInput" Text="{Binding Login}" PlaceholderText="you@example.com" />
        </StackPanel>

        <StackPanel Spacing="6">
            <TextBlock Text="Password" Classes="label" />
            <TextBox Text="{Binding Password}" PasswordChar="*" PlaceholderText="Password" />
        </StackPanel>

        <CheckBox Content="Remember me" IsChecked="{Binding RememberMe}" />

        <CheckBox IsChecked="{Binding ProfileDataConsent}"
                  IsVisible="{Binding IsRegistering}">
            <TextBlock Text="Optional consent: I explicitly agree to GymApp processing and storing my gender, date of birth, height and weight in my Firebase profile for Profile and Nutrition Calculator features. Calculator inputs are processed on this device and are not saved to Firebase. Workout tracking remains available if I decline. I can withdraw in Profile; saved profile measurements will be deleted."
                       TextWrapping="Wrap" MaxWidth="310" />
        </CheckBox>

        <TextBlock Text="{Binding ValidationMessage}"
                   Foreground="Red"
                   TextWrapping="Wrap"
                   IsVisible="{Binding ValidationMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

        <Button Content="Login"
                Command="{Binding LoginCommand}"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                IsVisible="{Binding !IsRegistering}" />

        <Button Content="Create account"
                Command="{Binding RegisterCommand}"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                IsVisible="{Binding IsRegistering}" />

        <Button Content="{Binding ToggleModeText}"
                Command="{Binding ToggleModeCommand}"
                HorizontalAlignment="Center" />

    </StackPanel>
    </ScrollViewer>

</Window>
