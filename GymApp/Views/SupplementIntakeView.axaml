<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GymApp.ViewModels"
             x:Class="GymApp.Views.SupplementIntakeView"
             x:DataType="vm:SupplementIntakeViewModel">

    <StackPanel Margin="20" Spacing="10">

        <TextBlock Text="Supplement" />
        <ComboBox ItemsSource="{Binding Supplements}"
                  SelectedItem="{Binding Supplement}">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Name}" />
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <TextBlock Text="Dosage" />
        <TextBox Text="{Binding SupplementDosage}" />

        <TextBlock Text="Day" />
        <ComboBox ItemsSource="{Binding DayOptions}"
                  SelectedItem="{Binding SupplementDay}" />

        <TextBlock Text="Time (hh:mm)" />
        <TextBox Text="{Binding SupplementTime}" />

        <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Content="Save" Command="{Binding SaveSupplementIntakeCommand}" />
            <Button Content="Delete" Command="{Binding DeleteSupplementCommand}" />
        </StackPanel>

        <TextBlock Text="Schedule:" Margin="0,10,0,0" />
        <ListBox ItemsSource="{Binding SupplementIntakes}"
                 SelectedItem="{Binding SelectedSupplementIntake}"
                 Height="200">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,4">
                        <TextBlock Text="{Binding Supplement.Name}" FontWeight="Bold" />
                        <TextBlock>
                            <Run Text="{Binding Date}" />
                            <Run Text=" — " />
                            <Run Text="{Binding Time}" />
                            <Run Text=" — " />
                            <Run Text="{Binding Dosage}" />
                        </TextBlock>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

    </StackPanel>

</UserControl>