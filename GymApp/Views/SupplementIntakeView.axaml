<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GymApp.ViewModels"
             x:Class="GymApp.Views.SupplementIntakeView"
             x:DataType="vm:SupplementIntakeViewModel">

    <Grid Margin="30" RowDefinitions="Auto,Auto,Auto,*,Auto">

        <TextBlock Grid.Row="0" Text="Supplement schedule" Classes="title" Margin="0,0,0,16" />

        <Button Grid.Row="1" Content="+ Add intake" Click="OpenAddIntakeWindow" HorizontalAlignment="Left" HorizontalContentAlignment="Center" Margin="0,0,0,12" />

        <TextBlock Grid.Row="2" Text="Schedule" Classes="label" Margin="0,0,0,8" />
        <Grid Grid.Row="3">
        <ListBox ItemsSource="{Binding SupplementIntakes}" SelectedItem="{Binding SelectedSupplementIntake}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Spacing="4">
                        <TextBlock Text="{Binding Supplement.Name}" FontSize="15" FontWeight="Bold" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Classes="label" Text="{Binding Date}" />
                            <TextBlock Classes="label" Text="·" />
                            <TextBlock Classes="label" Text="{Binding Time}" />
                            <TextBlock Classes="label" Text="·" />
                            <TextBlock Classes="label">
                                <Run Text="{Binding Dosage}" />
                                <Run Text="{Binding Supplement.DosageUnit}" />
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <Border IsVisible="{Binding IsIntakeListEmpty}" IsHitTestVisible="False"
                Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="12" Margin="4" Padding="24">
            <StackPanel Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Schedule is empty" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Text="Add a supplement reminder to see it here." Classes="label" TextWrapping="Wrap" TextAlignment="Center" />
            </StackPanel>
        </Border>
        </Grid>

        <Button Grid.Row="4" Content="Delete" Classes="danger" Click="OnDeleteSupplementIntake" HorizontalContentAlignment="Center" Width="80" Margin="0,12,0,0" IsEnabled="{Binding HasSelection}" />

    </Grid>

</UserControl>
