<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GymApp.ViewModels"
             x:Class="GymApp.Views.SupplementIntakeView"
             x:DataType="vm:SupplementIntakeViewModel">

    <StackPanel Margin="30" Spacing="16">

        <TextBlock Text="Supplement schedule" Classes="title" />

        <Button Content="+ Add intake" Click="OpenAddIntakeWindow" HorizontalAlignment="Left" HorizontalContentAlignment="Center" />

        <TextBlock Text="Schedule" Classes="label" Margin="0,10,0,0" />
        <ListBox ItemsSource="{Binding SupplementIntakes}" SelectedItem="{Binding SelectedSupplementIntake}" Height="400">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Spacing="4">
                        <TextBlock Text="{Binding Supplement.Name}" FontSize="15" FontWeight="Bold" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Classes="label" Text="{Binding Date}" />
                            <TextBlock Classes="label" Text="·" />
                            <TextBlock Classes="label" Text="{Binding Time}" />
                            <TextBlock Classes="label" Text="·" />
                            <TextBlock Classes="label">
                                <Run Text="{Binding Dosage}" />
                                <Run Text=" g" />
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Button Content="Delete" Classes="danger" Click="OnDeleteSupplementIntake" HorizontalContentAlignment="Center" Width="80" />

    </StackPanel>

</UserControl>