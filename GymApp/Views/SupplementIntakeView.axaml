<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GymApp.ViewModels"
             x:Class="GymApp.Views.SupplementIntakeView"
             x:DataType="vm:SupplementIntakeViewModel">

    <StackPanel Margin="20" Spacing="10">
        
        <Button Content="Add Intake" Click="OpenAddIntakeWindow" />

        <TextBlock Text="Schedule:" Margin="0,10,0,0" />
        <ListBox ItemsSource="{Binding SupplementIntakes}" SelectedItem="{Binding SelectedSupplementIntake}" Height="400">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,4">
                        <TextBlock Text="{Binding Supplement.Name}" FontWeight="Bold" />
                        <TextBlock>
                            <Run Text="{Binding Date}" />
                            <Run Text=" — " />
                            <Run Text="{Binding Time}" />
                            <Run Text=" — " />
                            <Run Text="{Binding Dosage}" />
                            <Run Text="g" />
                        </TextBlock>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        
        <Button Content="Delete" Click="OnDeleteSupplementIntake" />

    </StackPanel>

</UserControl>