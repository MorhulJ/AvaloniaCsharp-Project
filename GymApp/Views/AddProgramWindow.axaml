<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GymApp.ViewModels"
        x:Class="GymApp.Views.AddProgramWindow"
        x:DataType="vm:WorkoutProgramViewModel"
        Title="Add Program"
        Width="420" Height="300"
        WindowStartupLocation="CenterOwner">

    <StackPanel Margin="24" Spacing="14">

        <TextBlock Text="Program" Classes="title" FontSize="20" />

        <StackPanel Spacing="6">
            <TextBlock Text="Program name" Classes="label" />
            <TextBox Text="{Binding ProgramName}" />
        </StackPanel>

        <StackPanel Spacing="6">
            <TextBlock Text="Description" Classes="label" />
            <TextBox Text="{Binding ProgramDescription}" />
        </StackPanel>

        <Button Content="Save" Command="{Binding SaveProgramCommand}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" HorizontalAlignment="Stretch" Margin="0,10,0,0" />
        
        <TextBlock Text="{Binding ProgramValidationMessage}" 
                   Foreground="Red"
                   IsVisible="{Binding ProgramValidationMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        
    </StackPanel>

</Window>