<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GymApp.ViewModels"
             x:Class="GymApp.Views.PersonalRecordView"
             x:DataType="vm:PersonalRecordViewModel">

    <Grid Margin="30" RowDefinitions="Auto,Auto,Auto,*,Auto">

        <TextBlock Grid.Row="0" Text="Personal records" Classes="title" Margin="0,0,0,16" />

        <Button Grid.Row="1" Content="+ Add record" Click="OpenAddRecordWindow" HorizontalAlignment="Left" HorizontalContentAlignment="Center" Margin="0,0,0,12" />

        <TextBlock Grid.Row="2" Text="Records list" Classes="label" Margin="0,0,0,8" />
        <Grid Grid.Row="3">
        <ListBox ItemsSource="{Binding Records}" SelectedItem="{Binding SelectedRecord}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Spacing="4">
                        <TextBlock Text="{Binding Exercise.Name}" FontSize="15" FontWeight="Bold" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Classes="label">
                                <Run Text="{Binding Value}" />
                                <Run Text=" kg" />
                            </TextBlock>
                            <TextBlock Classes="label" Text="{Binding Date, StringFormat='{}{0:dd.MM.yyyy}'}" />
                        </StackPanel>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <Border IsVisible="{Binding IsRecordListEmpty}" IsHitTestVisible="False"
                Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="12" Margin="4" Padding="24">
            <StackPanel Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="No records yet" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Text="Log a personal record to see it here." Classes="label" TextWrapping="Wrap" TextAlignment="Center" />
            </StackPanel>
        </Border>
        </Grid>

        <Button Grid.Row="4" Content="Delete" Classes="danger" Click="OnDeleteRecord" HorizontalContentAlignment="Center" Width="80" Margin="0,12,0,0" IsEnabled="{Binding HasSelection}" />

    </Grid>

</UserControl>
