<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GymApp.ViewModels"
             x:Class="GymApp.Views.PersonalRecordView"
             x:DataType="vm:PersonalRecordViewModel">

    <StackPanel Margin="30" Spacing="16">

        <TextBlock Text="Personal records" Classes="title" />

        <Button Content="+ Add record" Click="OpenAddRecordWindow" HorizontalAlignment="Left" HorizontalContentAlignment="Center" />

        <TextBlock Text="Records list" Classes="label" Margin="0,10,0,0" />
        <ListBox ItemsSource="{Binding Records}" SelectedItem="{Binding SelectedRecord}" Height="400">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Spacing="4">
                        <TextBlock Text="{Binding Exercise.Name}" FontSize="15" FontWeight="Bold" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Classes="label">
                                <Run Text="{Binding Value}" />
                                <Run Text=" kg" />
                            </TextBlock>
                            <TextBlock Classes="label" Text="{Binding Date, StringFormat='{}{0:dd.MM.yyyy}'}" />
                        </StackPanel>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Button Content="Delete" Classes="danger" Click="OnDeleteRecord" HorizontalContentAlignment="Center" Width="80"/>

    </StackPanel>

</UserControl>