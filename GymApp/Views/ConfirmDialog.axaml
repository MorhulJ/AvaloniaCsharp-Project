<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="GymApp.Views.ConfirmDialog"
        Title="Confirm"
        Width="320" Height="160"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

    <StackPanel Margin="30" Spacing="24">

        <TextBlock Text="Are you sure?" 
                   Classes="title"
                   FontSize="20"
                   HorizontalAlignment="Center" />

        <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
            <Button Content="Yes" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="OnYes" Width="80" />
            <Button Content="No" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="OnNo" Width="80" Classes="danger" />
        </StackPanel>

    </StackPanel>

</Window>