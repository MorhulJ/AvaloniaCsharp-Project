<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="GymApp.Views.ConfirmDialog"
        Title="Confirm"
        Icon="avares://GymApp/Assets/gymapp_icon.png"
        Width="420" Height="210"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Opened="OnOpened"
        KeyDown="OnKeyDown">

    <StackPanel Classes="dialog-content" HorizontalAlignment="Center" VerticalAlignment="Center">

        <TextBlock x:Name="DialogTitle" Text="Confirm action"
                   Classes="title dialog-title"
                   HorizontalAlignment="Center" TextWrapping="Wrap" />

        <TextBlock x:Name="DialogMessage" TextWrapping="Wrap" TextAlignment="Center" />

        <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
            <Button x:Name="CancelButton" Content="Cancel" Classes="secondary" HorizontalContentAlignment="Center" Click="OnNo" MinWidth="100" />
            <Button x:Name="ConfirmButton" Content="Delete" Classes="danger" HorizontalContentAlignment="Center" Click="OnYes" MinWidth="100" />
        </StackPanel>

    </StackPanel>

</Window>
