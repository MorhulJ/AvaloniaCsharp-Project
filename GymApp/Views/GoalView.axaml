<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GymApp.ViewModels"
             x:Class="GymApp.Views.GoalView"
             x:DataType="vm:GoalViewModel">

    <Grid Margin="30" RowDefinitions="Auto,Auto,Auto,*,Auto">

        <TextBlock Grid.Row="0" Text="Goals" Classes="title" Margin="0,0,0,16" />

        <Button Grid.Row="1" Content="+ Add goal" Click="OpenAddGoalWindow" HorizontalAlignment="Left" HorizontalContentAlignment="Center" Margin="0,0,0,12" />

        <TextBlock Grid.Row="2" Text="Goal list" Classes="label" Margin="0,0,0,8" />
        <Grid Grid.Row="3">
        <ListBox ItemsSource="{Binding Goals}" SelectedItem="{Binding SelectedGoal}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Spacing="4">
                        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="Bold" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Classes="label">
                                <Run Text="Target: " />
                                <Run Text="{Binding TargetValue}" />
                            </TextBlock>
                            <TextBlock Classes="label">
                                <Run Text="Current: " />
                                <Run Text="{Binding CurrentValue}" />
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <Border IsVisible="{Binding IsGoalListEmpty}" IsHitTestVisible="False"
                Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="12" Margin="4" Padding="24">
            <StackPanel Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="No goals yet" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Text="Set a goal to keep your progress in focus." Classes="label" TextWrapping="Wrap" TextAlignment="Center" />
            </StackPanel>
        </Border>
        </Grid>

        <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
            <Button Content="Edit" Click="OpenEditGoalWindow" HorizontalContentAlignment="Center" Width="80" IsEnabled="{Binding HasSelection}" />
            <Button Content="Delete" Classes="danger" Click="OnDeleteGoal" HorizontalContentAlignment="Center" Width="80" IsEnabled="{Binding HasSelection}" />
        </StackPanel>

    </Grid>

</UserControl>
