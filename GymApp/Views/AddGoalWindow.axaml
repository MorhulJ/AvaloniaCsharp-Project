<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GymApp.ViewModels"
        x:Class="GymApp.Views.AddGoalWindow"
        x:DataType="vm:GoalViewModel"
        Title="Add Exercise"
        Width="400" Height="350"
        WindowStartupLocation="CenterOwner">

    <StackPanel Margin="20" Spacing="10">

        <TextBlock Text="Goal title" />
        <TextBox Text="{Binding GoalTitle}" />
        
        <TextBlock Text="Goal exercise" />
        <ComboBox ItemsSource="{Binding Exercises}"
                  SelectedItem="{Binding GoalExercise}">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Name}" />
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <TextBlock Text="Goal value" />
        <TextBox Text="{Binding GoalValue}" />

        <TextBlock Text="Current value" />
        <TextBox Text="{Binding CurrentValue}" />

        <Button Content="Save" Command="{Binding SaveGoalCommand}" />

    </StackPanel>

</Window>