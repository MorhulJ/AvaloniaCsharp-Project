<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GymApp.ViewModels"
        x:Class="GymApp.Views.AddGoalWindow"
        x:DataType="vm:GoalViewModel"
        Title="Add Goal"
        Width="420" Height="420"
        WindowStartupLocation="CenterOwner">

    <StackPanel Margin="24" Spacing="14">

        <TextBlock Text="Goal" Classes="title" FontSize="20" />

        <StackPanel Spacing="6">
            <TextBlock Text="Goal title" Classes="label" />
            <TextBox Text="{Binding GoalTitle}" />
        </StackPanel>

        <StackPanel Spacing="6">
            <TextBlock Text="Exercise" Classes="label" />
            <ComboBox ItemsSource="{Binding Exercises}"
                      SelectedItem="{Binding GoalExercise}"
                      HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </StackPanel>

        <StackPanel Spacing="6">
            <TextBlock Text="Target value" Classes="label" />
            <TextBox Text="{Binding GoalValue}" />
        </StackPanel>

        <StackPanel Spacing="6">
            <TextBlock Text="Current value" Classes="label" />
            <TextBox Text="{Binding CurrentValue}" />
        </StackPanel>

        <Button Content="Save" Command="{Binding SaveGoalCommand}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" HorizontalAlignment="Stretch" Margin="0,10,0,0" />

    </StackPanel>

</Window>