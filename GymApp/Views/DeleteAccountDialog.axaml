<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="GymApp.Views.DeleteAccountDialog"
        Title="Delete account"
        Icon="avares://GymApp/Assets/gymapp_icon.png"
        Width="460" Height="330"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

    <Border Margin="18"
            Padding="24"
            Background="{DynamicResource CardBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="12">
        <StackPanel Spacing="16">
            <TextBlock Text="Delete account" Classes="title dialog-title" />

            <TextBlock Text="This permanently deletes your account and saved workout data. You can't undo this."
                       TextWrapping="Wrap" />

            <StackPanel Spacing="7">
                <TextBlock Text="Confirm your identity with your password" Classes="label" />
                <TextBox x:Name="PasswordInput" PasswordChar="*" PlaceholderText="Password" />
            </StackPanel>

            <TextBlock x:Name="ErrorText"
                       Text="Enter your password to continue."
                       Foreground="#C74F3A"
                       IsVisible="False" />

            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button Content="Cancel" Classes="secondary" Click="OnCancel" MinWidth="100" />
                <Button Content="Delete account" Classes="danger" Click="OnDelete" MinWidth="140" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
