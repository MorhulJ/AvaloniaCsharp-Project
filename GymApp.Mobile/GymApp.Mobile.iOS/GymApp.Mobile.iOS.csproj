<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-ios</TargetFramework>
    <SupportedOSPlatformVersion>13.0</SupportedOSPlatformVersion>
    <AppIcon>AppIcon</AppIcon>
    <Nullable>enable</Nullable>
    <CodesignConfigureDependsOn>$(CodesignConfigureDependsOn);ConfigureSimulatorKeychain</CodesignConfigureDependsOn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.iOS" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GymApp.Mobile\GymApp.Mobile.csproj" />
  </ItemGroup>

  <Target Name="ConfigureSimulatorKeychain"
          Condition="'$(SdkIsSimulator)' == 'true' and '$(CodesignProvision)' == ''">
    <PropertyGroup>
      <CodesignRequireProvisioningProfile Condition="'$(CodesignRequireProvisioningProfile)' == ''">false</CodesignRequireProvisioningProfile>
    </PropertyGroup>
    <ItemGroup>
      <CustomEntitlements Include="application-identifier" Type="String" Value="com.morhulj.gymapp" />
    </ItemGroup>
  </Target>
</Project>
