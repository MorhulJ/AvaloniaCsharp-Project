<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <AvaloniaXaml Include="..\..\GymApp\Views\**\*.axaml"
                  Exclude="..\..\GymApp\Views\AddExerciseToProgramWindow.axaml;..\..\GymApp\Views\AddExerciseWindow.axaml;..\..\GymApp\Views\AddGoalWindow.axaml;..\..\GymApp\Views\AddIntakeWindow.axaml;..\..\GymApp\Views\AddProgramWindow.axaml;..\..\GymApp\Views\AddRecordWindow.axaml;..\..\GymApp\Views\AddSupplementWindow.axaml;..\..\GymApp\Views\ConfirmDialog.axaml;..\..\GymApp\Views\DeleteAccountDialog.axaml;..\..\GymApp\Views\WelcomeDialog.axaml;..\..\GymApp\Views\MainWindow.axaml;..\..\GymApp\Views\LoginWindow.axaml;..\..\GymApp\Views\UserView.axaml;..\..\GymApp\Views\NutritionView.axaml"
                  Link="SharedViews\%(RecursiveDir)%(Filename)%(Extension)" />
    <AvaloniaResource Include="..\..\GymApp\Styles\**\*.axaml" Link="Styles\%(Filename)%(Extension)" />
    <AvaloniaResource Include="..\..\GymApp\Assets\**\*" Link="Assets\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="FirebaseAuthentication.net" />
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="SkiaSharp" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\GymApp\Models\**\*.cs" Link="Shared\Models\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\..\GymApp\Services\**\*.cs" Link="Shared\Services\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\..\GymApp\Validators\**\*.cs" Link="Shared\Validators\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\..\GymApp\ViewModels\**\*.cs"
             Exclude="..\..\GymApp\ViewModels\MainWindowViewModel.cs"
             Link="Shared\ViewModels\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
