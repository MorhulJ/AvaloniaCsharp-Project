<TabbedPage xmlns="https://github.com/avaloniaui"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:vm="using:GymApp.Mobile.ViewModels"
            x:Class="GymApp.Mobile.Views.MainView"
            x:DataType="vm:MainViewModel">
    <ContentPage Header="Workout">
        <ContentControl Content="{Binding WorkoutProgram}" />
    </ContentPage>
    <ContentPage Header="Exercises">
        <ContentControl Content="{Binding Exercises}" />
    </ContentPage>
    <ContentPage Header="Goals">
        <ContentControl Content="{Binding Goals}" />
    </ContentPage>
    <ContentPage Header="Records">
        <Grid RowDefinitions="Auto,*">
            <StackPanel Margin="20,12,20,0" Spacing="8">
                <Button Content="Export PDF report" Classes="secondary" HorizontalAlignment="Stretch"
                        Click="OnExportReport" />
                <TextBlock x:Name="ReportMessage" TextWrapping="Wrap" IsVisible="False" />
            </StackPanel>
            <ContentControl Grid.Row="1" Content="{Binding PersonalRecords}" />
        </Grid>
    </ContentPage>
    <ContentPage Header="More">
        <TabControl FontSize="12" Padding="0">
            <TabItem>
                <TabItem.Header><TextBlock Text="Supplements" FontSize="13" /></TabItem.Header>
                <ContentControl Content="{Binding Supplements}" />
            </TabItem>
            <TabItem>
                <TabItem.Header><TextBlock Text="Schedule" FontSize="13" /></TabItem.Header>
                <ContentControl Content="{Binding SupplementSchedule}" />
            </TabItem>
            <TabItem>
                <TabItem.Header><TextBlock Text="Calculator" FontSize="13" /></TabItem.Header>
                <ContentControl Content="{Binding Nutrition}" />
            </TabItem>
            <TabItem>
                <TabItem.Header><TextBlock Text="Profile" FontSize="13" /></TabItem.Header>
                <ContentControl Content="{Binding Profile}" />
            </TabItem>
        </TabControl>
    </ContentPage>
</TabbedPage>
