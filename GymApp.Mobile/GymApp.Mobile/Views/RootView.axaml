<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GymApp.Mobile.ViewModels"
             x:Class="GymApp.Mobile.Views.RootView"
             x:DataType="vm:MainViewModel">
    <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0" Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="20,12">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="11" Background="{DynamicResource AccentBrush}">
                        <TextBlock Text="G" FontSize="21" FontWeight="Bold" Foreground="{DynamicResource BgBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="GymApp" FontSize="21" FontWeight="Bold" VerticalAlignment="Center" />
                </StackPanel>
                <Button Grid.Column="1" Content="{Binding ThemeActionText}" Command="{Binding ToggleThemeCommand}"
                        Classes="secondary" FontSize="12" Padding="12,8" />
            </Grid>
        </Border>
        <ContentControl Grid.Row="1" x:Name="Workspace" Content="{Binding CurrentContent}" />
        <Border Grid.RowSpan="2" x:Name="ModalLayer" IsVisible="False" Background="#99000000" Padding="16">
            <Border Background="{DynamicResource CardBrush}" CornerRadius="16" ClipToBounds="True"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    MaxWidth="398" VerticalAlignment="Center" MaxHeight="780">
                <Grid RowDefinitions="Auto,*">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="20,12,12,8">
                        <TextBlock x:Name="DialogHeading" Classes="title dialog-title"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1" Classes="secondary" Click="OnCloseDialog"
                                Width="44" Height="44" Padding="0" Background="Transparent" BorderThickness="0"
                                HorizontalAlignment="Right" AutomationProperties.Name="Close dialog" ToolTip.Tip="Close">
                            <Path Width="16" Height="16" Data="M 1,1 L 15,15 M 15,1 L 1,15"
                                  Stroke="{DynamicResource TextBrush}" StrokeThickness="2" />
                        </Button>
                    </Grid>
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
                        <ContentControl x:Name="DialogContent" />
                    </ScrollViewer>
                </Grid>
            </Border>
        </Border>
    </Grid>
</UserControl>
