<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:GymApp.Mobile.Views"
        x:Class="GymApp.Mobile.Views.MainWindow"
        Title="GymApp — iPhone 14 Pro Max Preview"
        Width="450" Height="900" MinWidth="300" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="#111111">
    <!-- Insets approximate portrait layout until verified on an iPhone.
         Viewbox scaling preserves a fixed logical viewport on smaller monitors. -->
    <Viewbox Stretch="Uniform" Margin="8">
        <Border Width="430" Height="932" CornerRadius="42" ClipToBounds="True"
                Background="{DynamicResource BgBrush}">
            <Grid RowDefinitions="59,*,34">
                <Border Grid.Row="0" Background="{DynamicResource BgBrush}">
                    <Border Width="125" Height="37" CornerRadius="19"
                            Background="Black" HorizontalAlignment="Center"
                            VerticalAlignment="Top" Margin="0,11,0,0" />
                </Border>
                <views:RootView Grid.Row="1" />
                <Border Grid.Row="2" Background="{DynamicResource BgBrush}">
                    <Border Width="134" Height="5" CornerRadius="3"
                            Background="{DynamicResource TextBrush}"
                            HorizontalAlignment="Center" VerticalAlignment="Bottom"
                            Margin="0,0,0,8" />
                </Border>
            </Grid>
        </Border>
    </Viewbox>
</Window>
