<mobile:MobileDialog xmlns:mobile="using:GymApp.Mobile.Views" xmlns="https://github.com/avaloniaui"
        xmlns:input="using:Avalonia.Input.TextInput"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GymApp.ViewModels"
        Title="Exercise"
        x:Class="GymApp.Views.AddExerciseWindow"
        x:DataType="vm:ExerciseViewModel">

    <StackPanel Classes="dialog-content">



        <StackPanel Spacing="6">
            <TextBlock Text="Exercise name" Classes="label" />
            <TextBox Text="{Binding ExerciseName}" PlaceholderText="e.g., Barbell squat" />
        </StackPanel>

        <StackPanel Spacing="6">
            <TextBlock Text="Muscle group" Classes="label" />
            <TextBox Text="{Binding MuscleGroup}" PlaceholderText="e.g., Legs" />
        </StackPanel>

        <StackPanel Spacing="6">
            <TextBlock Text="Description" Classes="label" />
            <TextBox Text="{Binding Description}" PlaceholderText="Short description of the movement" />
        </StackPanel>

        <Button Content="Save" Command="{Binding SaveExerciseCommand}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" HorizontalAlignment="Stretch" Margin="0,10,0,0" />

        <TextBlock Text="{Binding ValidationMessage}"
                   Foreground="Red"
                   IsVisible="{Binding ValidationMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

    </StackPanel>

</mobile:MobileDialog>
