<mobile:MobileDialog xmlns:mobile="using:GymApp.Mobile.Views" xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirm action"
        x:Class="GymApp.Views.ConfirmDialog"
        Opened="OnOpened"
        KeyDown="OnKeyDown">

    <StackPanel Classes="dialog-content" HorizontalAlignment="Stretch" VerticalAlignment="Center">



        <TextBlock x:Name="DialogMessage" TextWrapping="Wrap" TextAlignment="Center" />

        <StackPanel Orientation="Vertical" Spacing="12" HorizontalAlignment="Stretch">
            <Button x:Name="CancelButton" Content="Cancel" Classes="secondary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="OnNo" />
            <Button x:Name="ConfirmButton" Content="Delete" Classes="danger" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="OnYes" />
        </StackPanel>

    </StackPanel>

</mobile:MobileDialog>
