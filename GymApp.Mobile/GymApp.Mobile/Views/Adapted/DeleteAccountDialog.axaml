<mobile:MobileDialog xmlns:mobile="using:GymApp.Mobile.Views" xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Delete account"
        x:Class="GymApp.Views.DeleteAccountDialog">

    <Border Padding="20,8,20,24">
        <StackPanel Spacing="16">

            <TextBlock Text="This permanently deletes your account and saved workout data. You can't undo this."
                       TextWrapping="Wrap" />

            <StackPanel Spacing="7">
                <TextBlock Text="Confirm your identity with your password" Classes="label" />
                <TextBox x:Name="PasswordInput" PasswordChar="*" PlaceholderText="Password" />
            </StackPanel>

            <TextBlock x:Name="ErrorText"
                       Text="Enter your password to continue."
                       Foreground="#C74F3A"
                       IsVisible="False" />

            <StackPanel Orientation="Vertical" Spacing="10" HorizontalAlignment="Stretch" Margin="0,8,0,0">
                <Button Content="Cancel" Classes="secondary" HorizontalAlignment="Stretch" Click="OnCancel" />
                <Button Content="Delete account" Classes="danger" HorizontalAlignment="Stretch" Click="OnDelete" />
            </StackPanel>
        </StackPanel>
    </Border>
</mobile:MobileDialog>
