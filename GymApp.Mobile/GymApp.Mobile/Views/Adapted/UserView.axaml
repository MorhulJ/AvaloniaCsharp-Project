<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:input="using:Avalonia.Input.TextInput"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GymApp.ViewModels"
             x:Class="GymApp.Views.UserView"
             x:DataType="vm:UserViewModel">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="20" Spacing="16">

        <TextBlock Text="Profile" Classes="title" />

        <StackPanel Spacing="8">
            <TextBlock Text="Name" Classes="label" />
            <TextBox Text="{Binding UserName}" PlaceholderText="Your name" />
        </StackPanel>

        <Border IsVisible="{Binding !ProfileDataConsentGranted}"
                Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="10" Padding="18">
            <StackPanel Spacing="12">
                <TextBlock Text="Optional profile data" Classes="title dialog-title" />
                <TextBlock Text="Gender, date of birth, weight and height are optional. If you agree, GymApp will process and save them to your Firebase profile for Profile and Nutrition Calculator features. Calculator inputs are processed on this device and are not saved to Firebase. You can still use workout tracking without agreeing. You can withdraw at any time; saved profile measurements will be deleted."
                           TextWrapping="Wrap" />
                <CheckBox IsChecked="{Binding ProfileDataConsentChoice}">
                    <TextBlock Text="I explicitly consent to GymApp processing and saving these optional profile details."
                               TextWrapping="Wrap" />
                </CheckBox>
                <StackPanel Orientation="Vertical" Spacing="10">
                    <Button HorizontalAlignment="Stretch" Content="Agree and enable" Command="{Binding GrantProfileDataConsentCommand}"
                            HorizontalContentAlignment="Center" />
                    <Button HorizontalAlignment="Stretch" Click="OnDeleteUnconsentedData"
                            Classes="secondary" HorizontalContentAlignment="Center" ><TextBlock Text="Delete saved measurements" TextWrapping="Wrap" TextAlignment="Center" /></Button>
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid IsVisible="{Binding ProfileDataConsentGranted}"
              ColumnDefinitions="*" RowDefinitions="Auto,Auto,Auto,Auto">

            <StackPanel Grid.Column="0" Grid.Row="0" Spacing="6" Margin="0,0,0,12">
                <TextBlock Text="Gender" Classes="label" />
                <ComboBox ItemsSource="{Binding GenderOptions}"
                          SelectedItem="{Binding UserGender}"
                          HorizontalAlignment="Stretch" />
            </StackPanel>

            <StackPanel Grid.Column="0" Grid.Row="1" Spacing="6" Margin="0,0,0,12">
                <TextBlock Text="Weight (kg)" Classes="label" />
                <TextBox input:TextInputOptions.ContentType="Digits" Text="{Binding UserWeight}" PlaceholderText="e.g., 75" />
            </StackPanel>

            <StackPanel Grid.Column="0" Grid.Row="2" Spacing="6" Margin="0,0,0,12">
                <TextBlock Text="Height (cm)" Classes="label" />
                <TextBox input:TextInputOptions.ContentType="Digits" Text="{Binding UserHeight}" PlaceholderText="e.g., 180" />
            </StackPanel>

            <StackPanel Grid.Column="0" Grid.Row="3" Spacing="6" Margin="0,0,0,12">
                <TextBlock Text="Date of birth" Classes="label" />
                <DatePicker HorizontalAlignment="Stretch" Classes="profile-date" SelectedDate="{Binding UserDateOfBirth}" />
            </StackPanel>

        </Grid>

        <StackPanel Orientation="Vertical" Spacing="10">
        <Button Content="Save profile" Command="{Binding SaveUserCommand}"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                Margin="0,10,0,0" />
        <Button HorizontalAlignment="Stretch" Click="OnWithdrawProfileDataConsent"
                Classes="secondary" HorizontalContentAlignment="Center" Margin="0,10,0,0"
                IsVisible="{Binding ProfileDataConsentGranted}" ><TextBlock Text="Withdraw consent and delete measurements" TextWrapping="Wrap" TextAlignment="Center" /></Button>
        </StackPanel>

        <TextBlock Text="{Binding ValidationMessage}"
                   Classes="feedback" Classes.success="{Binding IsValidationSuccess}"
                   TextWrapping="Wrap"
                   IsVisible="{Binding ValidationMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

        <StackPanel Orientation="Vertical" Spacing="10">
            <Button HorizontalAlignment="Stretch" Content="Logout" Command="{Binding LogoutCommand}" Classes="danger" HorizontalContentAlignment="Center" />
            <Button HorizontalAlignment="Stretch" Content="Delete account" Click="OnDeleteAccount" Classes="danger" HorizontalContentAlignment="Center" />
        </StackPanel>

    </StackPanel>

    </ScrollViewer>
</UserControl>
