<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mobile="using:GymApp.Mobile.Views">
    <Styles.Resources>
        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="{DynamicResource AccentColor}" />
    </Styles.Resources>
    <Style Selector="UserControl, TabbedPage, ContentPage, TabControl">
        <Setter Property="Background" Value="{DynamicResource BgBrush}" />
    </Style>
    <Style Selector="TextBlock">
        <Setter Property="FontFamily" Value="avares://Avalonia.Fonts.Inter/Assets#Inter" />
    </Style>
    <Style Selector="TextBox, ComboBox, Button">
        <Setter Property="FontFamily" Value="avares://Avalonia.Fonts.Inter/Assets#Inter" />
    </Style>
    <Style Selector="TextBlock.title">
        <Setter Property="FontSize" Value="25" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.dialog-title">
        <Setter Property="FontSize" Value="22" />
    </Style>
    <Style Selector="Button">
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="CornerRadius" Value="11" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="16,10" />
    </Style>
    <Style Selector="Button /template/ ContentPresenter">
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBox, ComboBox">
        <Setter Property="MinHeight" Value="46" />
        <Setter Property="CornerRadius" Value="11" />
    </Style>
    <Style Selector="TextBox">
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="ComboBox">
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBox /template/ TextPresenter">
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBox /template/ TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="DatePicker.profile-date">
        <Setter Property="Width" Value="NaN" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="MinHeight" Value="46" />
    </Style>
    <Style Selector="ListBoxItem">
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="16,14" />
        <Setter Property="Margin" Value="0,0,0,10" />
    </Style>
    <Style Selector="TabItem">
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
        <Setter Property="Background" Value="{DynamicResource BgBrush}" />
        <Setter Property="MinHeight" Value="44" />
    </Style>
    <Style Selector="TabItem:selected">
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TabItem /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BgBrush}" />
    </Style>
    <Style Selector=":is(mobile|MobileDialog)">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector=":is(mobile|MobileDialog) TextBlock">
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="StackPanel.dialog-content">
        <Setter Property="Margin" Value="20,8,20,24" />
        <Setter Property="Spacing" Value="16" />
    </Style>
</Styles>
